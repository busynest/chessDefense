{
  "name": "chessdefense",
  "version": "2.0.0",
  "description": "ChessDefense is a new type of game, a cross between chess and tower defense.",
  "type": "module",
  "repository": "https://www.chessdefense.com",
  "author": "Modern Projects",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "tsc && concurrently -k -n tsc,web \"tsc --watch --preserveWatchOutput\" \"web-dev-server --config web-dev-server.config.mjs\"",
    "build": "tsc && rollup -c",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "firebase": "^12.0.0",
    "lit": "^3.3.0",
    "pwa-auth": "^3.8.0",
    "pwa-helpers": "^0.9.1",
    "redux": "^5.0.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@web/dev-server": "^0.4.6",
    "concurrently": "^9.2.0",
    "rollup": "^4.40.0",
    "typescript": "^5.9.0"
  }
}
